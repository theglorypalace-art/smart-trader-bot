TELEGRAM_BOT_TOKEN=your_bot_token_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Optional overrides
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_LEADERBOARD_URL=https://stats-data.hyperliquid.xyz/Mainnet/leaderboard

# Quality pool (top by profit) thresholds
MIN_PNL_30D_USD=10000
MIN_WIN_RATE_PCT=45
MIN_ACCOUNT_VALUE_USD=25000
MAX_TRACKED_TRADERS=30

# Activity pool (top by trade frequency) thresholds
MAX_ACTIVE_TRADERS=20
ACTIVITY_LOOKBACK_DAYS=2
MIN_ACTIVE_ACCOUNT_VALUE_USD=10000
MIN_TRADES_PER_DAY=3

# Refresh interval (ms)
TRADER_REFRESH_INTERVAL_MS=900000

# Comma-separated Telegram chat IDs allowed to run /customers
ADMIN_CHAT_IDS=123456789

# ============================================================
# AUTO-TRADING (real order execution) — every default below is
# the SAFE default. Real mainnet trading with real funds requires
# explicitly changing both AUTO_TRADE_ENABLED and
# HYPERLIQUID_IS_TESTNET below.
# ============================================================

# Required before any /connect can store an agent key.
# Generate with: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=

# Global kill switch. Must be "true" (exact string) for any real order
# to ever be placed, no matter what individual users have set.
AUTO_TRADE_ENABLED=false

# "false" (exact string) switches to Hyperliquid MAINNET — real funds.
# Leave as "true" (testnet) until you've fully verified behavior.
HYPERLIQUID_IS_TESTNET=true

# Hard ceiling on what any user can set via /capital (percent)
MAX_CAPITAL_PCT_ALLOWED=20

# IOC limit order slippage buffer, percent
DEFAULT_SLIPPAGE_PCT=1
